{
	"nodes":[
		{"id":"831461ff66424670","type":"text","text":"# Protocols for Human-AI Effectiveness","x":0,"y":-30,"width":280,"height":120},
		{"id":"08d317ef442a4a70","type":"text","text":"Hyptheses","x":380,"y":-1332,"width":280,"height":60,"color":"1"},
		{"id":"3b8ce1ced33844e9","type":"text","text":"Humans need to be in the loop","x":760,"y":-1782,"width":280,"height":60,"color":"1"},
		{"id":"6ccd2d65cc9e4921","type":"text","text":"Due to human constraints","x":1140,"y":-2000,"width":280,"height":60,"color":"1"},
		{"id":"8c6c64955a09401f","type":"text","text":"Due to their own (human) lack of clarity about their intentions","x":1520,"y":-2096,"width":280,"height":68,"color":"1"},
		{"id":"a639cd03e5914486","type":"text","text":"Due to intentions evolving with evidence","x":1520,"y":-2004,"width":280,"height":68,"color":"1"},
		{"id":"c512cf19352a4319","type":"text","text":"Due to their poor ability to communicate intentions","x":1520,"y":-1912,"width":280,"height":68,"color":"1"},
		{"id":"b42aa0f217dd4f56","type":"text","text":"Especially through limited means like text and images","x":1900,"y":-1912,"width":280,"height":68,"color":"1"},
		{"id":"c00f77d87eff4655","type":"text","text":"Due to AI constraints","x":1140,"y":-1644,"width":280,"height":60,"color":"1"},
		{"id":"586223e32c6e4637","type":"text","text":"Due to AI lacking intentionality","x":1520,"y":-1736,"width":280,"height":60,"color":"1"},
		{"id":"cf18d62b49c14faf","type":"text","text":"Always true, due to bounded taxonomy","x":1900,"y":-1736,"width":280,"height":60,"color":"1"},
		{"id":"956ee3917b0e45cc","type":"text","text":"Deterministic","x":2280,"y":-1820,"width":280,"height":60,"color":"1"},
		{"id":"b34de51566554101","type":"text","text":"Stochastic","x":2280,"y":-1736,"width":280,"height":60,"color":"1"},
		{"id":"65e71aafcff14ffc","type":"text","text":"Intentional","x":2280,"y":-1652,"width":280,"height":60,"color":"1"},
		{"id":"433f99ec07404924","type":"text","text":"Due to Ai lacking causal understanding","x":1520,"y":-1568,"width":280,"height":68,"color":"1"},
		{"id":"c4e231f4f1864faa","type":"text","text":"World models may augment this","x":1900,"y":-1568,"width":280,"height":60,"color":"1"},
		{"id":"51d2a981f38a4d2f","type":"text","text":"Due to hallucinations","x":1520,"y":-1472,"width":280,"height":60,"color":"1"},
		{"id":"93050c16ca3c46d6","type":"text","text":"Always possible with finite training data","x":1900,"y":-1476,"width":280,"height":68,"color":"1"},
		{"id":"93e705f8a1244825","type":"text","text":"Protocols are the interface for humans in the loop","x":760,"y":-1300,"width":280,"height":68,"color":"1"},
		{"id":"f258de07ed414e97","type":"text","text":"To supply intentionality","x":1140,"y":-1384,"width":280,"height":60,"color":"1"},
		{"id":"69ed91ad34e04529","type":"text","text":"For AI to execute","x":1140,"y":-1300,"width":280,"height":60,"color":"1"},
		{"id":"addd0410620a4033","type":"text","text":"To produce a coherent transhuman experience","x":1140,"y":-1216,"width":280,"height":68,"color":"1"},
		{"id":"c41d01b825f346ac","type":"text","text":"Human + AI + Protocol > Human + AI > Human","x":1520,"y":-1216,"width":280,"height":68,"color":"1"},
		{"id":"40c1df930f5545ba","type":"text","text":"Protocols for effective human collaboration extend well to transhuman collaboration","x":760,"y":-861,"width":280,"height":90,"color":"1"},
		{"id":"c6684f62c4084d9c","type":"text","text":"Because AI was trained on human data","x":1140,"y":-1120,"width":280,"height":60,"color":"1"},
		{"id":"3e4cd79f43154de6","type":"text","text":"And can’t be self-training on human domains","x":1520,"y":-1124,"width":280,"height":68,"color":"1"},
		{"id":"797ae9e12bec4436","type":"text","text":"Unlike e.g. well-bounded domains like chess","x":1900,"y":-1124,"width":280,"height":68,"color":"1"},
		{"id":"a55bb85705114a86","type":"text","text":"Because the protocols and their results need to be inspectable (predicated on humans need to be in the loop reasoning)","x":1140,"y":-1032,"width":280,"height":112,"color":"1"},
		{"id":"027884110e4344b4","type":"text","text":"Because human constraints are a limiting factor","x":1140,"y":-896,"width":280,"height":68,"color":"1"},
		{"id":"99c56642701745e3","type":"text","text":"Because humans have access to context that AI will never have without the human","x":1140,"y":-804,"width":280,"height":90,"color":"1"},
		{"id":"24e4e86c247a4deb","type":"text","text":"Because humans are the final arbiter of success or failure in relation to their intentions","x":1140,"y":-690,"width":280,"height":90,"color":"1"},
		{"id":"a00bded08ef84e5e","type":"text","text":"Because humans inherit the real-world consequences","x":1140,"y":-576,"width":280,"height":68,"color":"1"},
		{"id":"27fa8a9996164d61","type":"text","text":"\tAnd will be accountable to other humans in existential ways","x":1520,"y":-576,"width":280,"height":92,"color":"1"},
