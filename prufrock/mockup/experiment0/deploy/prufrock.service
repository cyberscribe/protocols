[Unit]
Description=Prufrock Experiment 0 — daily-interrupt poetry bot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=prufrock
WorkingDirectory=/home/prufrock/protocols/prufrock/mockup/experiment0
EnvironmentFile=/home/prufrock/protocols/prufrock/mockup/experiment0/.env
ExecStart=/home/prufrock/protocols/prufrock/mockup/experiment0/.venv/bin/prufrock-bot
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=prufrock

# Harden the service: no new privileges, private /tmp
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
