<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>The Prufrock Protocol — Timeline Complete</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:1440px;height:900px;overflow:hidden;background:#0c0c0f;color:#eae6de;font-family:-apple-system,'Segoe UI',system-ui,sans-serif;font-size:13px}
nav{height:44px;background:#131318;border-bottom:1px solid #1e1e2a;display:flex;align-items:center;padding:0 24px;gap:2px}
.brand{display:flex;align-items:baseline;gap:10px;margin-right:28px}
.brand-name{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
.brand-sub{font-size:10px;letter-spacing:.06em;color:#c8a040;opacity:.75}
.nav-tab{height:44px;padding:0 14px;display:flex;align-items:center;font-size:11px;letter-spacing:.05em;color:#4a4644;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px}
.nav-tab.active{color:#eae6de;border-bottom-color:#c8a040}
.nav-right{margin-left:auto;font-size:10px;color:#5a5654}
.controls{height:40px;background:#0f0f14;border-bottom:1px solid #1a1a26;display:flex;align-items:center;padding:0 24px;gap:20px}
.cohort-btns{display:flex;border:1px solid #1e1e2a;border-radius:3px;overflow:hidden}
.cbt{padding:4px 11px;font-size:10px;color:#4a4644;border-right:1px solid #1e1e2a}
.cbt:last-child{border-right:none}
.cbt.active{background:rgba(255,255,255,.05);color:#eae6de}
.slider-group{display:flex;align-items:center;gap:8px;flex:1;max-width:400px}
.slider-lbl{font-size:10px;color:#4a4644;white-space:nowrap}
.track{flex:1;height:3px;background:#1a1a26;border-radius:2px;position:relative}
.fill{position:absolute;left:0;top:0;height:100%;background:#c8a040;border-radius:2px;width:100%}
.thumb{position:absolute;top:50%;left:100%;transform:translate(-50%,-50%);width:10px;height:10px;border-radius:50%;background:#c8a040;border:2px solid #0c0c0f}
.play{width:22px;height:22px;border-radius:50%;background:#1a1a26;border:1px solid #1e1e2a;display:flex;align-items:center;justify-content:center;color:#5a5654;font-size:7px}
.ctrl-right{margin-left:auto;font-size:10px;color:#4a4644;display:flex;gap:14px;align-items:center}
.legend-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.leg{display:flex;align-items:center;gap:4px;font-size:9px;color:#4a4644}
.leg-sq{width:8px;height:8px;border-radius:1px;flex-shrink:0}
.seed-strip{height:36px;background:rgba(200,160,64,.06);border-bottom:1px solid rgba(200,160,64,.15);display:flex;align-items:center;padding:0 24px;gap:16px}
.ss-tag{font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#c8a040;opacity:.7}
.ss-line{font-family:Georgia,serif;font-style:italic;font-size:12px;color:rgba(200,160,64,.7)}
.ss-right{margin-left:auto;font-size:10px;color:#4a4644}
.view{height:780px;display:flex;flex-direction:column;padding:10px 0 0}
.tl-header{display:flex;align-items:center;padding:0 20px 6px 20px}
.tl-h-spacer{width:128px;flex-shrink:0}
.tl-days{display:flex;flex:1;gap:2px}
.day-col{flex:1;text-align:center;font-size:8px;color:#5a5654;letter-spacing:.04em;font-weight:600;text-transform:uppercase}
.tl-body{flex:1;overflow:hidden;padding:0 20px;display:flex;flex-direction:column}
.cohort-section{margin-bottom:4px}
.cohort-label{display:flex;align-items:center;gap:8px;padding:4px 0 3px;border-bottom:1px solid #161620}
.cohort-dot{width:7px;height:7px;border-radius:2px}
.cohort-dot.poet{background:#c8785a}
.cohort-dot.lay{background:#5a8fd4}
.cohort-name{font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#4a4644}
.cohort-stats{font-size:9px;color:#2e2c28;margin-left:auto}
.poem-row{display:flex;align-items:center;height:27px;margin-bottom:2px}
.p-label{width:128px;flex-shrink:0}
.p-num{font-size:8px;font-family:monospace;color:#3a3634}
.cells{display:flex;flex:1;gap:2px;height:21px}
.cell{flex:1;height:100%;border-radius:2px;display:flex;align-items:center;justify-content:center}
.cell-init{font-size:6px;font-weight:700;color:rgba(255,255,255,.45);font-family:monospace}
.summary-bar{height:44px;background:#0e0e14;border-top:1px solid #1a1a26;display:flex;align-items:center;padding:0 24px;gap:32px;flex-shrink:0}
.sb-stat{display:flex;flex-direction:column}
.sb-n{font-size:18px;font-weight:200;color:#eae6de;line-height:1}
.sb-l{font-size:8px;color:#3a3634;letter-spacing:.08em;text-transform:uppercase;margin-top:1px}
.sb-div{width:1px;height:28px;background:#1a1a26}
</style>
</head>
<body>
<nav>
  <div class="brand"><span class="brand-name">The Prufrock Protocol</span><span class="brand-sub">Sonnet Experiment Alpha</span></div>
  <div class="nav-tab active">Timeline</div>
  <div class="nav-tab">Lineage</div>
  <div class="nav-tab">Map</div>
  <div class="nav-tab">Poem</div>
  <div class="nav-tab">Participant</div>
  <div class="nav-right">Day 14 of 14 · Complete · 196 lines</div>
</nav>
<div class="controls">
  <div class="cohort-btns">
    <div class="cbt active">Poets</div>
    <div class="cbt">Laypeople</div>
    <div class="cbt">Both</div>
  </div>
  <div class="slider-group">
    <span class="slider-lbl">Day</span>
    <div class="track"><div class="fill"></div><div class="thumb"></div></div>
    <span class="slider-lbl">14 / 14</span>
    <div class="play">■</div>
  </div>
  <div class="ctrl-right">
    <div class="legend-row" id="legend"></div>
  </div>
</div>
<div class="seed-strip">
  <span class="ss-tag">Seed</span>
  <span class="ss-line">Nor shall death brag thou wander'st in his shade, · When in eternal lines to time thou grow'st:</span>
  <span class="ss-right">W. Shakespeare · 1609 → 2026 · 14 poets · 14 poems · 196 lines</span>
</div>
<div class="view">
  <div class="tl-header">
    <div class="tl-h-spacer"></div>
    <div class="tl-days" id="day-headers"></div>
  </div>
  <div class="tl-body" id="tl-body"></div>
  <div class="summary-bar">
    <div class="sb-stat"><div class="sb-n">14</div><div class="sb-l">Poems</div></div>
    <div class="sb-div"></div>
    <div class="sb-stat"><div class="sb-n">196</div><div class="sb-l">Lines total</div></div>
    <div class="sb-div"></div>
    <div class="sb-stat"><div class="sb-n">14</div><div class="sb-l">Authors per poem</div></div>
    <div class="sb-div"></div>
    <div class="sb-stat"><div class="sb-n">14</div><div class="sb-l">Poems per author</div></div>
    <div class="sb-div"></div>
    <div class="sb-stat"><div class="sb-n">2</div><div class="sb-l">Forfeits</div></div>
    <div class="sb-div"></div>
    <div class="sb-stat" style="margin-left:auto"><div class="sb-n" style="color:#3a8a4a">✓ Complete</div><div class="sb-l">Latin square satisfied</div></div>
  </div>
</div>
<script>
const AUTHORS = [
  {id:'AO',name:'Amara Osei',loc:'Accra',color:'#c87850'},
  {id:'HT',name:'Hiroshi',loc:'Kyoto',color:'#7060c0'},
  {id:'MF',name:'Marisol',loc:'B.Aires',color:'#b05890'},
  {id:'SN',name:'Siobhán',loc:'Galway',color:'#40a870'},
  {id:'EŞ',name:'Elif',loc:'Istanbul',color:'#e09020'},
  {id:'MP',name:'Meera',loc:'Kochi',color:'#c04848'},
  {id:'AD',name:'Antoine',loc:'Dakar',color:'#4890d0'},
  {id:'YN',name:'Yuki',loc:'Sapporo',color:'#98b030'},
  {id:'LB',name:'Lena',loc:'Berlin',color:'#9858b0'},
  {id:'CA',name:'Carlos',loc:'Lisbon',color:'#50a8a0'},
  {id:'ND',name:'Naledi',loc:'J\'burg',color:'#e0a040'},
  {id:'PL',name:'Pham Lan',loc:'Hanoi',color:'#d07040'},
  {id:'VG',name:'Valentina',loc:'Naples',color:'#6090b0'},
  {id:'BL',name:'Björn',loc:'Stockholm',color:'#80b870'},
];

const N = 14;

// Legend
const leg = document.getElementById('legend');
AUTHORS.forEach(a => {
  const el = document.createElement('div');
  el.className = 'leg';
  el.innerHTML = `<div class="leg-sq" style="background:${a.color}"></div>${a.id}`;
  leg.appendChild(el);
});

// Day headers
const dh = document.getElementById('day-headers');
for (let d = 1; d <= N; d++) {
  const el = document.createElement('div');
  el.className = 'day-col';
  el.textContent = 'D' + d;
  dh.appendChild(el);
}

function makeSection(label, cls, note) {
  const sec = document.createElement('div');
  sec.className = 'cohort-section';
  sec.innerHTML = `<div class="cohort-label"><div class="cohort-dot ${cls}"></div><span class="cohort-name">${label}</span><span class="cohort-stats">${note}</span></div>`;
  return sec;
}

function makeRow(pIdx) {
  const row = document.createElement('div');
  row.className = 'poem-row';
  row.innerHTML = `<div class="p-label"><span class="p-num">Poem ${String(pIdx+1).padStart(2,'0')}</span></div>`;
  const cells = document.createElement('div');
  cells.className = 'cells';
  // One cell per day — forfeit: poem 2 day 10 (just cosmetic)
  for (let d = 0; d < N; d++) {
    const cell = document.createElement('div');
    const aIdx = (pIdx - d + N * 100) % N;
    const a = AUTHORS[aIdx];
    const isForfeit = (pIdx === 2 && d === 9);
    cell.className = 'cell';
    if (isForfeit) {
      cell.style.cssText = 'background:#111116;border:1px dashed #2a2838;opacity:.5';
      cell.innerHTML = '<span class="cell-init" style="color:#3a3634">✕</span>';
    } else {
      cell.style.background = a.color + '28';
      cell.innerHTML = `<span class="cell-init" style="color:${a.color}bb">${a.id}</span>`;
    }
    cells.appendChild(cell);
  }
  row.appendChild(cells);
  return row;
}

const body = document.getElementById('tl-body');
const poetSec = makeSection('Poets','poet','14 poems · 196 lines · 14 unique authors per poem');
for (let p = 0; p < N; p++) poetSec.appendChild(makeRow(p));
body.appendChild(poetSec);
</script>
</body>
</html>
