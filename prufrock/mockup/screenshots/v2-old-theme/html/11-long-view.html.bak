<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>The Prufrock Protocol — Concerns: Long View 1609–2126</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:1440px;height:900px;overflow:hidden;background:#0c0c0f;color:#eae6de;font-family:-apple-system,'Segoe UI',system-ui,sans-serif;font-size:13px}
nav{height:44px;background:#131318;border-bottom:1px solid #1e1e2a;display:flex;align-items:center;padding:0 24px;gap:2px}
.brand{display:flex;align-items:baseline;gap:10px;margin-right:28px}
.brand-name{font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
.brand-sub{font-size:10px;letter-spacing:.06em;color:#c8a040;opacity:.75}
.nav-tab{height:44px;padding:0 14px;display:flex;align-items:center;font-size:11px;letter-spacing:.05em;color:#4a4644;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px}
.nav-tab.active{color:#eae6de;border-bottom-color:#c8a040}
.nav-right{margin-left:auto;font-size:10px;color:#3a3634}
.controls{height:40px;background:#0f0f14;border-bottom:1px solid #1a1a26;display:flex;align-items:center;padding:0 24px;gap:20px}
.cohort-btns{display:flex;border:1px solid #1e1e2a;border-radius:3px;overflow:hidden}
.cbt{padding:4px 11px;font-size:10px;color:#4a4644;border-right:1px solid #1e1e2a}
.cbt:last-child{border-right:none}
.cbt.active{background:rgba(255,255,255,.05);color:#eae6de}
.view-btns{display:flex;border:1px solid #1e1e2a;border-radius:3px;overflow:hidden}
.vbt{padding:4px 11px;font-size:10px;color:#4a4644;border-right:1px solid #1e1e2a}
.vbt:last-child{border-right:none}
.vbt.active{background:rgba(255,255,255,.05);color:#eae6de}
.ctrl-right{margin-left:auto;font-size:10px;color:#4a4644}
.seed-strip{height:36px;background:rgba(200,160,64,.06);border-bottom:1px solid rgba(200,160,64,.15);display:flex;align-items:center;padding:0 24px;gap:16px}
.ss-tag{font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#c8a040;opacity:.7}
.ss-line{font-family:Georgia,serif;font-style:italic;font-size:12px;color:rgba(200,160,64,.7)}
.ss-right{margin-left:auto;font-size:10px;color:#4a4644}
#chart{display:block}
</style>
</head>
<body>
<nav>
  <div class="brand"><span class="brand-name">The Prufrock Protocol</span><span class="brand-sub">Sonnet Experiment Alpha</span></div>
  <div class="nav-tab">Timeline</div>
  <div class="nav-tab">Lineage</div>
  <div class="nav-tab">Map</div>
  <div class="nav-tab">Poem</div>
  <div class="nav-tab">Participant</div>
  <div class="nav-tab active">Concerns</div>
  <div class="nav-right">Long view · 517-year span · 1609 → 2026 → 2126 · themes persisting and drifting</div>
</nav>
<div class="controls">
  <div class="cohort-btns"><div class="cbt active">Poets</div><div class="cbt">Laypeople</div><div class="cbt">Both</div></div>
  <div class="view-btns"><div class="vbt">Theme river</div><div class="vbt">Theme network</div><div class="vbt active">Long view</div></div>
  <div class="ctrl-right">2026 experiment · heir poems spawn further seeds for future cohorts · concern drift is speculative</div>
</div>
<div class="seed-strip">
  <span class="ss-tag">Seed · 1609</span>
  <span class="ss-line">Nor shall death brag thou wander'st in his shade, · When in eternal lines to time thou grow'st:</span>
  <span class="ss-right">W. Shakespeare · fragments of 2026 poems become seeds for 2126 poets</span>
</div>
<svg id="chart" xmlns="http://www.w3.org/2000/svg" width="1440" height="780"></svg>
<script>
const svg = document.getElementById('chart');
const W = 1440, H = 780;

// 10 themes — 9 existing + Climate / survival (new in 2126)
const THEMES = [
  {name:'Mortality / impermanence', short:'Mortality',  color:'#9070b8'},
  {name:'Time / aging',             short:'Time',       color:'#c8a040'},
  {name:'Love / longing',           short:'Love',       color:'#c04070'},
  {name:'Memory / preservation',    short:'Memory',     color:'#4080c0'},
  {name:'Wonder / awe',             short:'Wonder',     color:'#50b090'},
  {name:'Solitude / alienation',    short:'Solitude',   color:'#908090'},
  {name:'Domestic life',            short:'Domestic',   color:'#c07848'},
  {name:'Grief / loss',             short:'Grief',      color:'#507888'},
  {name:'Identity / selfhood',      short:'Identity',   color:'#78a060'},
  {name:'Climate / survival',       short:'Climate',    color:'#3a9060'}, // new — emerges in 2126
];

const T = THEMES.length;

// All columns: 1 seed + 14 poems of 2026 + 5 future 2126 = 20
// Climate theme is 0 or near-0 for seed and 2026 poems; grows in 2126
const rawData = [
  // Seed (1609)
  [0.28, 0.24, 0.20, 0.18, 0.07, 0.02, 0.00, 0.01, 0.00, 0.00],
  // 2026 poems P01–P14
  [0.26, 0.23, 0.19, 0.18, 0.07, 0.03, 0.01, 0.02, 0.01, 0.00],
  [0.25, 0.23, 0.20, 0.19, 0.07, 0.03, 0.01, 0.01, 0.01, 0.00],
  [0.26, 0.22, 0.19, 0.20, 0.06, 0.03, 0.02, 0.01, 0.01, 0.00],
  [0.24, 0.23, 0.20, 0.19, 0.07, 0.04, 0.01, 0.01, 0.01, 0.00],
  [0.22, 0.21, 0.18, 0.18, 0.06, 0.07, 0.04, 0.02, 0.02, 0.01],
  [0.11, 0.13, 0.11, 0.13, 0.04, 0.16, 0.22, 0.04, 0.06, 0.00], // P06 divergent
  [0.20, 0.19, 0.17, 0.17, 0.06, 0.10, 0.07, 0.02, 0.02, 0.00],
  [0.23, 0.21, 0.18, 0.18, 0.07, 0.07, 0.04, 0.01, 0.01, 0.00],
  [0.24, 0.22, 0.19, 0.19, 0.07, 0.05, 0.02, 0.01, 0.01, 0.00],
  [0.25, 0.22, 0.19, 0.19, 0.07, 0.04, 0.02, 0.01, 0.01, 0.00],
  [0.25, 0.23, 0.19, 0.18, 0.07, 0.04, 0.02, 0.01, 0.01, 0.00],
  [0.24, 0.23, 0.20, 0.18, 0.07, 0.04, 0.02, 0.01, 0.01, 0.00],
  [0.25, 0.22, 0.19, 0.19, 0.08, 0.04, 0.01, 0.01, 0.01, 0.00],
  [0.25, 0.23, 0.19, 0.19, 0.07, 0.04, 0.01, 0.01, 0.01, 0.00],
  // 2126 future cohort — Climate emerges, Mortality fades, Memory grows
  [0.21, 0.20, 0.17, 0.21, 0.09, 0.07, 0.02, 0.01, 0.04, 0.03], // F01
  [0.18, 0.19, 0.16, 0.22, 0.10, 0.08, 0.02, 0.01, 0.05, 0.05], // F02
  [0.16, 0.18, 0.15, 0.22, 0.10, 0.08, 0.02, 0.01, 0.06, 0.07], // F03
  [0.14, 0.17, 0.14, 0.22, 0.11, 0.09, 0.02, 0.01, 0.06, 0.09], // F04
  [0.13, 0.16, 0.13, 0.22, 0.11, 0.09, 0.02, 0.01, 0.07, 0.10], // F05
];

const COLS = rawData.length; // 20 = 1 + 14 + 5

const norm = rawData.map(row => {
  const s = row.reduce((a,b) => a+b, 0);
  return row.map(v => v/s);
});
const cum = norm.map(row => {
  const c = [0];
  row.forEach(v => c.push(c[c.length-1] + v));
  return c;
});

function el(tag, attrs, parent) {
  const e = document.createElementNS('http://www.w3.org/2000/svg', tag);
  for (const [k,v] of Object.entries(attrs)) e.setAttribute(k, v);
  if (parent) parent.appendChild(e);
  return e;
}
function txt(x, y, t, attrs, parent) {
  const e = el('text', {x, y, 'text-anchor':'middle', 'dominant-baseline':'middle', ...attrs}, parent);
  e.textContent = t;
  return e;
}

el('rect', {width:W, height:H, fill:'#0c0c0f'}, svg);
const defs = el('defs', {}, svg);

// Chart geometry
const CT = 54, CB = 700;
const CH = CB - CT;

// Column x positions — three zones with visual breaks
// Zone 1: Seed (1609) — 1 col at x=90
// Zone 2: 2026 — 14 cols from x=160 to x=800
// Zone 3: 2126 — 5 cols from x=960 to x=1220
const SEED_COL_X = 90;
const Z2_L = 160, Z2_R = 820; // 2026 zone
const Z3_L = 960, Z3_R = 1250; // 2126 zone

const colX = i => {
  if (i === 0) return SEED_COL_X;
  if (i <= 14) return Z2_L + (Z2_R - Z2_L) * (i - 1) / 13;
  return Z3_L + (Z3_R - Z3_L) * (i - 15) / 4;
};
const cumY = (col, t) => CB - cum[col][t] * CH;

// ─── Background zones ─────────────────────────────────────────
// 2026 zone background
el('rect', {x:Z2_L-8, y:CT-22, width:Z2_R-Z2_L+16, height:CH+46, fill:'rgba(255,255,255,.012)', rx:2}, svg);

// 2126 zone background (more faded)
el('rect', {x:Z3_L-8, y:CT-22, width:Z3_R-Z3_L+16, height:CH+46, fill:'rgba(60,144,96,.03)', rx:2}, svg);

// Time-break hatching between seed and 2026
const bk1x = (SEED_COL_X + Z2_L) / 2;
for (let y = CT; y < CB; y += 10) {
  el('line', {x1:bk1x-8, y1:y, x2:bk1x+8, y2:y+8, stroke:'rgba(255,255,255,.05)', 'stroke-width':'1'}, svg);
}
el('line', {x1:bk1x, y1:CT-20, x2:bk1x, y2:CB+10, stroke:'#1a1a26', 'stroke-width':'1.5'}, svg);

// Time-break between 2026 and 2126
const bk2x = (Z2_R + Z3_L) / 2;
for (let y = CT; y < CB; y += 10) {
  el('line', {x1:bk2x-8, y1:y, x2:bk2x+8, y2:y+8, stroke:'rgba(255,255,255,.05)', 'stroke-width':'1'}, svg);
}
el('line', {x1:bk2x, y1:CT-20, x2:bk2x, y2:CB+10, stroke:'#1a1a26', 'stroke-width':'1.5'}, svg);

// Zone labels
txt(SEED_COL_X, CT-14, '1609', {fill:'rgba(200,160,64,.6)', 'font-size':'8.5', 'font-family':'monospace', 'font-weight':'700'}, svg);
txt((Z2_L+Z2_R)/2, CT-14, '2026  ·  Sonnet Experiment Alpha  ·  14 collaborative poems', {fill:'#3a3634', 'font-size':'8', 'font-family':'monospace'}, svg);
txt((Z3_L+Z3_R)/2, CT-14, '2126  ·  projected', {fill:'rgba(58,144,96,.45)', 'font-size':'8', 'font-family':'monospace', 'font-style':'italic'}, svg);
txt(bk1x, CT-14, '→ 417 yrs →', {fill:'#1e1c1a', 'font-size':'7', 'font-family':'monospace'}, svg);
txt(bk2x, CT-14, '→ 100 yrs →', {fill:'#1e1c1a', 'font-size':'7', 'font-family':'monospace'}, svg);

// ─── Ribbons ─────────────────────────────────────────────────
// Draw between adjacent columns that are in the SAME zone (no ribbon crossing breaks)
const inSameZone = (i, j) => {
  if (i === 0 && j === 1) return false; // seed-to-2026: skip (too jarring)
  if (i === 14 && j === 15) return false; // 2026-to-2126: skip
  return true;
};

for (let i = 0; i < COLS-1; i++) {
  if (!inSameZone(i, i+1)) continue;
  const x0 = colX(i), x1 = colX(i+1);
  const cx = (x0+x1)/2;
  const is2126 = (i >= 15);
  for (let t = 0; t < T; t++) {
    const bot0 = cumY(i, t), top0 = cumY(i, t+1);
    const bot1 = cumY(i+1, t), top1 = cumY(i+1, t+1);
    const heightAvg = Math.abs((bot0-top0) + (bot1-top1))/2;
    if (heightAvg < 1) continue; // skip negligible ribbons
    const d = `M${x0},${bot0} C${cx},${bot0},${cx},${bot1},${x1},${bot1} L${x1},${top1} C${cx},${top1},${cx},${top0},${x0},${top0} Z`;
    el('path', {d, fill: THEMES[t].color + (is2126 ? '50' : '90'), stroke: THEMES[t].color+'10', 'stroke-width':'0.3'}, svg);
  }
}

// Standalone seed column caps
const sxL = SEED_COL_X - 6, sxR = SEED_COL_X + 6;
for (let t = 0; t < T; t++) {
  const bot = cumY(0, t), top = cumY(0, t+1);
  if (top >= bot - 1) continue;
  el('rect', {x:sxL, y:top, width:sxR-sxL, height:bot-top, fill:THEMES[t].color+'a0', rx:1}, svg);
}

// Standalone 2126 column caps (faded thin bars)
for (let ci = 15; ci < COLS; ci++) {
  const cx = colX(ci);
  for (let t = 0; t < T; t++) {
    const bot = cumY(ci, t), top = cumY(ci, t+1);
    if (top >= bot - 1) continue;
    el('rect', {x:cx-4, y:top, width:8, height:bot-top, fill:THEMES[t].color+'60', rx:1}, svg);
  }
}

// 2026 column thin dividers
for (let i = 1; i <= 14; i++) {
  el('line', {x1:colX(i), y1:CT, x2:colX(i), y2:CB, stroke:'rgba(0,0,0,.2)', 'stroke-width':'0.4'}, svg);
}

// Poem 06 divergence marker in 2026 zone
const p6x = colX(6);
el('line', {x1:p6x, y1:CT, x2:p6x, y2:CB, stroke:'rgba(192,120,72,.35)', 'stroke-width':'1.2'}, svg);
txt(p6x, CB+14, 'P06', {fill:'#c07848aa', 'font-size':'7', 'font-family':'monospace'}, svg);

// Column labels for 2026 poems
for (let i = 1; i <= 14; i++) {
  txt(colX(i), CB+14, 'P'+String(i).padStart(2,'0'), {fill:'#2e2c2a', 'font-size':'6.5', 'font-family':'monospace'}, svg);
}
// 2126 column labels
for (let i = 0; i < 5; i++) {
  txt(colX(i+15), CB+14, 'F0'+(i+1), {fill:'rgba(58,144,96,.3)', 'font-size':'6.5', 'font-family':'monospace'}, svg);
}

// ─── Climate emergence annotation ────────────────────────────
const climX = Z3_L + 40;
const climY = cumY(16, 9) + (cumY(16, T) - cumY(16, 9)) / 2; // midpoint of Climate ribbon in F02
el('rect', {x:climX-8, y:climY-18, width:180, height:36, rx:3, fill:'rgba(10,14,12,.95)', stroke:'rgba(58,144,96,.4)', 'stroke-width':'1'}, svg);
txt(climX+82, climY-7, 'Climate / survival', {fill:'#3a9060', 'font-size':'9', 'font-weight':'600'}, svg);
txt(climX+82, climY+6, 'new concern · absent in 1609 and 2026', {fill:'#3a5040', 'font-size':'7.5'}, svg);

// ─── Legend ──────────────────────────────────────────────────
const LX = Z3_R + 20;
txt(LX + 72, CT+4, 'CONCERNS', {fill:'#2a2826', 'font-size':'7', 'font-weight':'700', 'letter-spacing':'.1em'}, svg);
const legStep = (CB - CT - 16) / T;
THEMES.forEach((th, i) => {
  const ly = CT + 16 + i * legStep + legStep/2;
  el('rect', {x:LX, y:ly-5, width:9, height:9, rx:2, fill:th.color+'90'}, svg);
  txt(LX+14, ly, th.name, {fill: th.name === 'Climate / survival' ? '#3a9060aa' : '#4a4848', 'font-size':'7.5', 'text-anchor':'start'}, svg);
  if (th.name === 'Climate / survival') {
    txt(LX+14, ly+11, '← new in 2126', {fill:'#2a4038', 'font-size':'6.5', 'font-family':'monospace', 'text-anchor':'start'}, svg);
  }
});

// Bottom annotation
txt((Z2_L+Z2_R)/2, H-12, 'Most concerns persist across 517 years · Memory grows · Mortality fades · Climate / survival emerges as the 21st → 22nd century concern that Shakespeare could not have named',
  {fill:'#222020', 'font-size':'7.5'}, svg);
</script>
<div style="position:fixed;bottom:0;left:0;width:100%;background:#cc0000;color:#fff;text-align:center;font-size:11px;font-weight:700;letter-spacing:.25em;padding:4px 0;z-index:9999">MOCKUP</div>
</body>
</html>
