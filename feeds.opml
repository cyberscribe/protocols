<?xml version="1.0" encoding="UTF-8"?>

<opml version="1.0">
    <head>
        <title>Robert subscriptions — Human-AI collaboration protocols</title>
    </head>
    <body>
        <!--
        Companion OPML for the human-AI collaboration protocols research thread.
        Source of truth: 00-protocols/feeds-config.json.
        This file lists the RSS-mode sources only — directly importable to Feedly or any OPML-compatible reader.

        Page-diff sources (no RSS feed — handled by the surveillance pipeline against site HTML):
          - Anthropic — Transformer Circuits (https://transformer-circuits.pub/)
          - Anthropic — News (https://www.anthropic.com/news)
          - Anthropic — Alignment (https://alignment.anthropic.com/)
          - Stanford HAI — News (https://hai.stanford.edu/news)
          - Ribbonfarm (https://www.ribbonfarm.com/)
          - Long Now Foundation (https://longnow.org/ideas/)
          - DataChutney (https://datachutney.io/)
          - Bret Victor — Worrydream (https://worrydream.com/)
          - Linus Lee — thesephist (https://thesephist.com/)
          - METR (https://metr.org/blog)
          - Apollo Research (https://www.apolloresearch.ai/blog)
          - Kevin Kelly — The Technium (https://kk.org/thetechnium/)
          - RadicalxChange / Plurality (https://www.radicalxchange.org/blog/)
        -->
        <outline text="AI Practice &amp; Tooling" title="AI Practice &amp; Tooling">
            <outline type="rss" text="Simon Willison's Weblog" title="Simon Willison's Weblog" xmlUrl="https://simonwillison.net/atom/everything/" htmlUrl="https://simonwillison.net/"/>
